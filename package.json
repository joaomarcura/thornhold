{
  "name": "thornhold",
  "version": "0.6.6-alpha.1",
  "private": true,
  "type": "module",
  "description": "Thornhold — authoritative asymmetric 3D multiplayer vertical slice",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch scripts/dev-server.js",
    "start:dev": "node scripts/dev-server.js",
    "test": "node --test tests/*.test.js",
    "test:fast": "node scripts/test-suite.js fast",
    "test:long": "node scripts/test-suite.js long",
    "test:smoke": "node --test tests/economy.test.js tests/performance.test.js tests/progression.test.js tests/review.test.js",
    "test:load": "node scripts/load-test.js",
    "test:load:mature": "node scripts/load-test.js --mature",
    "test:remote": "node scripts/remote-smoke.js",
    "simulate": "node scripts/simulate.js",
    "simulate:arena": "node scripts/arena.js",
    "test:review:browser": "node scripts/browser-review.js",
    "test:sanctuary:browser": "node scripts/browser-sanctuary.js",
    "test:stun:browser": "node scripts/browser-stun-scoreboard.js",
    "test:spectator:browser": "node scripts/browser-lifecycle.js",
    "test:movement:browser": "node scripts/browser-troll-movement.js",
    "test:terrain:browser": "node scripts/browser-terrain.js",
    "test:accessibility:browser": "node scripts/browser-accessibility.js",
    "test:platform:browser": "node scripts/browser-platform.js",
    "test:performance:browser": "node scripts/browser-performance.js",
    "check": "node scripts/check.js",
    "verify": "node scripts/verify.js",
    "verify:fast": "node scripts/verify.js --fast",
    "balance": "node scripts/balance.js",
    "audit:combat": "node scripts/combat-audit.js",
    "audit:economy": "node scripts/economy-audit.js",
    "audit:sensitivity": "node scripts/sensitivity.js",
    "audit:profiles": "node scripts/profile-lab.js",
    "audit:progression": "node scripts/progression-audit.js",
    "audit:compare": "node scripts/compare-progression.js",
    "release:check": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "0.180.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "agent-browser": "^0.38.1"
  }
}
